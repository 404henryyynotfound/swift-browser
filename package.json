{
  "name": "swift-browser",
  "version": "1.0.0",
  "private": true,
  "description": "Swift — a fast, private desktop browser with tracker blocking, fingerprint defense and tab sleeping.",
  "main": "main.js",
  "author": {
    "name": "Swift Browser",
    "email": "support@swift-browser.surge.sh"
  },
  "homepage": "https://swift-browser.surge.sh",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "start:lite": "SWIFT_EDITION=lite electron .",
    "start:enterprise": "SWIFT_EDITION=enterprise electron .",
    "start:beta": "SWIFT_EDITION=beta electron .",
    "start:nightly": "SWIFT_EDITION=nightly electron .",
    "start:canary": "SWIFT_EDITION=nightly electron .",
    "start:developer": "SWIFT_EDITION=developer electron .",
    "dist:linux-arm64": "electron-builder --linux --arm64",
    "dist:linux-x64": "electron-builder --linux --x64",
    "dist:lite:arm64": "sh scripts/dist-edition.sh lite arm64",
    "dist:lite:x64": "sh scripts/dist-edition.sh lite x64",
    "dist:enterprise:arm64": "sh scripts/dist-edition.sh enterprise arm64",
    "dist:enterprise:x64": "sh scripts/dist-edition.sh enterprise x64",
    "dist:beta:arm64": "sh scripts/dist-edition.sh beta arm64",
    "dist:beta:x64": "sh scripts/dist-edition.sh beta x64",
    "dist:nightly:arm64": "sh scripts/dist-edition.sh nightly arm64",
    "dist:nightly:x64": "sh scripts/dist-edition.sh nightly x64",
    "dist:developer:arm64": "sh scripts/dist-edition.sh developer arm64",
    "dist:developer:x64": "sh scripts/dist-edition.sh developer x64",
    "dist:snap": "electron-builder --linux snap",
    "test": "node privacy/test.js && node lib/swift-apps.test.js && node lib/editions.test.js",
    "check": "node --check main.js && node --check preload.js && node --check apps-preload.js && node --check ui-preload.js && node --check privacy/blocklist.js && node --check lib/store.js && node --check lib/editions.js && node --check lib/swift-apps.js && node --check lib/editions.test.js && node --check lib/swift-apps.test.js && node --check ui/app.js && node --check ui/apps/apps.js && node --check site/app.js && npm test"
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "24.13.3"
  }
}
